<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dg_pkg</name>
  <version>0.0.0</version>
  <description>Competition ROS2 package for the Digua robotics smart-car project.</description>
  <maintainer email="maintainer@example.com">DG Robot Team</maintainer>
  <license>Apache-2.0</license>
  
  <buildtool_depend>ament_python</buildtool_depend>

  <!-- ROS2 核心 -->
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>action_msgs</depend>
  <depend>rcl_interfaces</depend>

  <!-- 地平线 AI -->
  <depend>dnn_node_msg</depend>

  <!-- 图像处理 -->
  <depend>cv_bridge</depend>
  <depend>python3-opencv</depend>

  <!-- Navigation2 导航栈 (M10) -->
  <depend>nav2_amcl</depend>
  <depend>nav2_map_server</depend>
  <depend>nav2_planner</depend>
  <depend>nav2_controller</depend>
  <depend>nav2_regulated_pure_pursuit_controller</depend>
  <depend>nav2_bt_navigator</depend>
  <depend>nav2_bringup</depend>
  <depend>nav2_behaviors</depend>
  <depend>nav2_smoother</depend>
  <depend>nav2_lifecycle_manager</depend>
  <depend>nav2_waypoint_follower</depend>
  <depend>nav2_velocity_smoother</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>nav2_smac_planner</depend>
  <depend>nav2_msgs</depend>
  <depend>launch_ros</depend>
  <depend>launch</depend>
  <depend>ament_index_python</depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
